# Openfront Home Services. Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://user:password@host:5432/openfront_home_services
# Only for `npm run migrate:gen` (Prisma's shadow database).
SHADOW_DATABASE_URL=postgresql://user:password@host:5432/openfront_home_services_shadow
# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Optional: DB tests run against a dedicated schema, e.g. ...?schema=vitest
HS_TEST_DATABASE_URL=
# Optional: the dashboard assistant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: password-reset mail. Without SMTP, mail is logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Leave unset: staff accounts are created by an owner, not by public sign-up.
PUBLIC_SIGNUPS_ALLOWED=
# Optional: seals gate codes and integration credentials (AES-256-GCM). Falls back to SESSION_SECRET.
SECRET_BOX_KEY=
# Optional: texting and on-call paging through Twilio. Without these, texts and pages become office tasks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional: transaction lock wait in ms (default 15000).
HS_TX_MAX_WAIT_MS=
