  policyVersionId  String?         @map("policyVersion")
  result           String          @default("allowed")
  findings         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@index([workLineId])
  @@index([equipmentModelId])
  @@index([policyVersionId])
}

model RefrigerantLogEntry {
  id              String               @id @default(cuid())
  idempotencyKey  String               @unique @default("")
  kind            String               @default("charge")
  equipment       InstalledEquipment?  @relation("RefrigerantLogEntry_equipment", fields: [equipmentId], references: [id])
  equipmentId     String?              @map("equipment")
  job             Job?                 @relation("RefrigerantLogEntry_job", fields: [jobId], references: [id])
  jobId           String?              @map("job")
  cylinder        RefrigerantCylinder? @relation("RefrigerantLogEntry_cylinder", fields: [cylinderId], references: [id])
  cylinderId      String?              @map("cylinder")
  refrigerantType String               @default("")
  quantityLb      Decimal              @postgresql.Decimal(18, 4)
  technician      Employee?            @relation("RefrigerantLogEntry_technician", fields: [technicianId], references: [id])
  technicianId    String?              @map("technician")
  credential      Credential?          @relation("RefrigerantLogEntry_credential", fields: [credentialId], references: [id])
  credentialId    String?              @map("credential")
  occurredAt      DateTime?
  notes           String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

