  serialOrTag                       String                @unique @default("")
  refrigerantType                   String                @default("")
  kind                              String                @default("virgin")
  location                          StockLocation?        @relation("RefrigerantCylinder_location", fields: [locationId], references: [id])
  locationId                        String?               @map("location")
