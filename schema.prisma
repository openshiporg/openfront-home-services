model PriceBookItem {
  id                              String            @id @default(cuid())
  priceBookVersion                PriceBookVersion? @relation("PriceBookItem_priceBookVersion", fields: [priceBookVersionId], references: [id])
  priceBookVersionId              String?           @map("priceBookVersion")
  itemKey                         String            @default("")
  kind                            String            @default("service_task")
  categoryKey                     String            @default("")
  name                            String            @default("")
  customerDescription             String            @default("")
  internalNotes                   String            @default("")
  trade                           String            @default("general")
  businessUnit                    BusinessUnit?     @relation("PriceBookItem_businessUnit", fields: [businessUnitId], references: [id])
  businessUnitId                  String?           @map("businessUnit")
  pricingMethod                   String            @default("fixed")
  unitPriceMinor                  BigInt            @default(0)
  memberUnitPriceMinor            BigInt?
  costMinor                       BigInt            @default(0)
  laborHours                      Decimal?          @postgresql.Decimal(18, 4)
  uom                             String            @default("")
  taxCategory                     String            @default("labor")
  warrantyText                    String            @default("")
  equipmentModel                  EquipmentModel?   @relation("PriceBookItem_equipmentModel", fields: [equipmentModelId], references: [id])
  equipmentModelId                String?           @map("equipmentModel")
  materials                       Json?
  commissionCode                  String            @default("")
  spiffCode                       String            @default("")
  cancellationClassDefault        String            @default("requested_repair")
  ladderKey                       String            @default("")
  tier                            String            @default("")
  sortOrder                       Int               @default(0)
  active                          Boolean           @default(true)
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @default(now()) @updatedAt
  from_EstimateLine_pricebookItem EstimateLine[]    @relation("EstimateLine_pricebookItem")

  @@unique([priceBookVersionId, itemKey], map: "PriceBookItem_version_key_key")
  @@index([priceBookVersionId])
  @@index([itemKey])
  @@index([businessUnitId])
  @@index([equipmentModelId])
  @@index([ladderKey])
}

model PriceBookVersion {
  id                                    String              @id @default(cuid())
  priceBook                             PriceBook?          @relation("PriceBookVersion_priceBook", fields: [priceBookId], references: [id])
  priceBookId                           String?             @map("priceBook")
  versionNumber                         Int
  label                                 String              @default("")
  status                                String              @default("draft")
  source                                String              @default("manual")
  basedOn                               PriceBookVersion?   @relation("PriceBookVersion_basedOn", fields: [basedOnId], references: [id])
  basedOnId                             String?             @map("basedOn")
  notes                                 String              @default("")
  effectiveAt                           DateTime?
  contentHash                           String              @default("")
  diffReport                            Json?
  costChangeReport                      Json?
  approval                              ApprovalRequest?    @relation("PriceBookVersion_approval", fields: [approvalId], references: [id])
  approvalId                            String?             @map("approval")
  submittedBy                           User?               @relation("PriceBookVersion_submittedBy", fields: [submittedById], references: [id])
  submittedById                         String?             @map("submittedBy")
  submittedAt                           DateTime?
  publishedBy                           User?               @relation("PriceBookVersion_publishedBy", fields: [publishedById], references: [id])
  publishedById                         String?             @map("publishedBy")
  publishedAt                           DateTime?
  activatedAt                           DateTime?
  retiredAt                             DateTime?
  categories                            PriceBookCategory[] @relation("PriceBookCategory_priceBookVersion")
  items                                 PriceBookItem[]     @relation("PriceBookItem_priceBookVersion")
  markupTables                          MarkupTable[]       @relation("MarkupTable_priceBookVersion")
  laborRates                            LaborRate[]         @relation("LaborRate_priceBookVersion")
  memberPricingRules                    MemberPricingRule[] @relation("MemberPricingRule_priceBookVersion")
  version                               Int                 @default(0)
  createdAt                             DateTime            @default(now())
  updatedAt                             DateTime            @default(now()) @updatedAt
  from_ChangeOrder_priceBookVersion     ChangeOrder[]       @relation("ChangeOrder_priceBookVersion")
  from_EstimateVersion_priceBookVersion EstimateVersion[]   @relation("EstimateVersion_priceBookVersion")
  from_PriceBook_activeVersion          PriceBook[]         @relation("PriceBook_activeVersion")
  from_PriceBookVersion_basedOn         PriceBookVersion[]  @relation("PriceBookVersion_basedOn")

  @@unique([priceBookId, versionNumber], map: "PriceBookVersion_book_number_key")
  @@index([priceBookId])
  @@index([basedOnId])
  @@index([approvalId])
  @@index([submittedById])
  @@index([publishedById])
}

model Refund {
  id           String              @id @default(cuid())
  ref          String              @unique @default("")
  payment      Payment?            @relation("Refund_payment", fields: [paymentId], references: [id])
  paymentId    String?             @map("payment")
  notice       CancellationNotice? @relation("Refund_notice", fields: [noticeId], references: [id])
  noticeId     String?             @map("notice")
  method       String              @default("processor_refund")
  amountMinor  BigInt
  reference    String              @default("")
  refundedAt   DateTime
  recordedBy   User?               @relation("Refund_recordedBy", fields: [recordedById], references: [id])
  recordedById String?             @map("recordedBy")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  @@index([paymentId])
  @@index([noticeId])
  @@index([recordedById])
}

model UnitOfMeasure {
  id          String   @id @default(cuid())
  code        String   @unique @default("")
  name        String   @default("")
  kind        String   @default("count")
  maxDecimals Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

enum UserKindType {
  staff
  customer
  payer_contact
  agent_owner
}
