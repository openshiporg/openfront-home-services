model EarningLine {
  id                        String          @id @default(cuid())
  payPeriod                 PayPeriod?      @relation("EarningLine_payPeriod", fields: [payPeriodId], references: [id])
  payPeriodId               String?         @map("payPeriod")
  employee                  Employee?       @relation("EarningLine_employee", fields: [employeeId], references: [id])
  employeeId                String?         @map("employee")
  workweekStart             DateTime        @postgresql.Date
  kind                      String
  hours                     Decimal?        @postgresql.Decimal(18, 4)
  rateMinor                 BigInt          @default(0)
  amountMinor               BigInt
  basisType                 String          @default("")
  basisId                   String          @default("")
  basisVersion              Int?            @default(0)
  payPlanVersion            PayPlanVersion? @relation("EarningLine_payPlanVersion", fields: [payPlanVersionId], references: [id])
  payPlanVersionId          String?         @map("payPlanVersion")
  earningCode               String          @default("")
  regularRateReview         Boolean         @default(false)
  reverses                  EarningLine?    @relation("EarningLine_reverses", fields: [reversesId], references: [id])
  reversesId                String?         @map("reverses")
  lineKey                   String          @default("")
  note                      String          @default("")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @default(now()) @updatedAt
  from_EarningLine_reverses EarningLine[]   @relation("EarningLine_reverses")

  @@unique([payPeriodId, lineKey], map: "EarningLine_period_line_key")
  @@index([payPeriodId])
  @@index([employeeId])
  @@index([basisId])
  @@index([payPlanVersionId])
  @@index([reversesId])
  @@index([lineKey])
}

model PayPeriod {
  id                         String               @id @default(cuid())
  startsOn                   DateTime             @unique @postgresql.Date
  endsOn                     DateTime             @postgresql.Date
  payDate                    DateTime             @postgresql.Date
  status                     String               @default("open")
  approval                   ApprovalRequest?     @relation("PayPeriod_approval", fields: [approvalId], references: [id])
  approvalId                 String?              @map("approval")
  inputsHash                 String               @default("")
  summary                    Json?
  calculatedAt               DateTime?
  earningLines               EarningLine[]        @relation("EarningLine_payPeriod")
  batches                    PayrollExportBatch[] @relation("PayrollExportBatch_payPeriod")
  version                    Int                  @default(0)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @default(now()) @updatedAt
  from_TimeSegment_payPeriod TimeSegment[]        @relation("TimeSegment_payPeriod")

  @@index([approvalId])
}

model PayPlan {
  id        String           @id @default(cuid())
  name      String           @unique @default("")
  active    Boolean          @default(false)
  versions  PayPlanVersion[] @relation("PayPlanVersion_plan")
  version   Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
}

