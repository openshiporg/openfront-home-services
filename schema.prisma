  assignedBy        User?                   @relation("VisitAssignment_assignedBy", fields: [assignedById], references: [id])
  assignedById      String?                 @map("assignedBy")
  assignedByAgent   AgentIdentity?          @relation("VisitAssignment_assignedByAgent", fields: [assignedByAgentId], references: [id])
  assignedByAgentId String?                 @map("assignedByAgent")
  recommendation    DispatchRecommendation? @relation("VisitAssignment_recommendation", fields: [recommendationId], references: [id])
  recommendationId  String?                 @map("recommendation")
  overrideReason    String                  @default("")
  eligibility       EligibilityEvaluation?  @relation("VisitAssignment_eligibility", fields: [eligibilityId], references: [id])
  eligibilityId     String?                 @map("eligibility")
  active            Boolean                 @default(true)
  endedAt           DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt

  @@index([visitId])
  @@index([employeeId])
  @@index([assignedById])
  @@index([assignedByAgentId])
  @@index([recommendationId])
  @@index([eligibilityId])
}

model VisitStatusEvent {
  id               String    @id @default(cuid())
  visit            Visit?    @relation("VisitStatusEvent_visit", fields: [visitId], references: [id])
  visitId          String?   @map("visit")
  employee         Employee? @relation("VisitStatusEvent_employee", fields: [employeeId], references: [id])
  employeeId       String?   @map("employee")
  actorUser        User?     @relation("VisitStatusEvent_actorUser", fields: [actorUserId], references: [id])
  actorUserId      String?   @map("actorUser")
  fromStatus       String    @default("")
  toStatus         String    @default("")
  kind             String
  occurredAt       DateTime
  clientRecordedAt DateTime?
  idempotencyKey   String    @unique @default("")
  lat              Decimal?  @postgresql.Decimal(9, 6)
  lng              Decimal?  @postgresql.Decimal(9, 6)
  deviceId         String    @default("")
  note             String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([visitId])
  @@index([employeeId])
  @@index([actorUserId])
}

model WorkLine {
  id                String   @id @default(cuid())
  job               Job?     @relation("WorkLine_job", fields: [jobId], references: [id])
  jobId             String?  @map("job")
  source            String
  description       String   @default("")
  snapshot          Json?
  quantity          Decimal  @postgresql.Decimal(18, 4)
  uom               String   @default("")
  unitPriceMinor    BigInt   @default(0)
  amountMinor       BigInt   @default(0)
  taxCategory       String
  trade             String
  cancellationClass String
  status            String   @default("planned")
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([jobId])
}

enum UserKindType {
  staff
  customer
  payer_contact
  agent_owner
}
