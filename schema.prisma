  @@unique([timesheetId, sourceKey], map: "TimeSegment_sheet_source_key")
  @@index([timesheetId])
  @@index([visitId])
  @@index([sourceKey])
  @@index([adjustsId])
  @@index([approvalId])
  @@index([payPeriodId])
  @@index([createdById])
}

model Timesheet {
  id            String        @id @default(cuid())
