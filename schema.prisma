  updatedAt                         DateTime              @default(now()) @updatedAt
  from_RefrigerantLogEntry_cylinder RefrigerantLogEntry[] @relation("RefrigerantLogEntry_cylinder")

  @@index([itemId])
  @@index([locationId])
}

model RefrigerantInstallCheck {
  id               String          @id @default(cuid())
