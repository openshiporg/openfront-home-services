  @@index([payPeriodId])
  @@index([createdById])
}

model TimeSegment {
  id                       String           @id @default(cuid())
  timesheet                Timesheet?       @relation("TimeSegment_timesheet", fields: [timesheetId], references: [id])
  timesheetId              String?          @map("timesheet")
  kind                     String
  startsAt                 DateTime
  endsAt                   DateTime
  hours                    Decimal?         @postgresql.Decimal(18, 4)
  visit                    Visit?           @relation("TimeSegment_visit", fields: [visitId], references: [id])
  visitId                  String?          @map("visit")
  source                   String
  sourceKey                String           @default("")
  adjusts                  TimeSegment?     @relation("TimeSegment_adjusts", fields: [adjustsId], references: [id])
  adjustsId                String?          @map("adjusts")
  approval                 ApprovalRequest? @relation("TimeSegment_approval", fields: [approvalId], references: [id])
  approvalId               String?          @map("approval")
