  workLineId             String?               @map("workLine")
  membership             Membership?           @relation("CommissionAttribution_membership", fields: [membershipId], references: [id])
  membershipId           String?               @map("membership")
  financingApplication   FinancingApplication? @relation("CommissionAttribution_financingApplication", fields: [financingApplicationId], references: [id])
