  approvedBy    User?         @relation("Timesheet_approvedBy", fields: [approvedById], references: [id])
  approvedById  String?       @map("approvedBy")
  approvedAt    DateTime?
  rejectReason  String        @default("")
  totalHours    Decimal?      @postgresql.Decimal(18, 4)
  segments      TimeSegment[] @relation("TimeSegment_timesheet")
  version       Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@unique([employeeId, workDate], map: "Timesheet_employee_date_key")
  @@index([employeeId])
  @@index([approvedById])
}

