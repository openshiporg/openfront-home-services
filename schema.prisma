model PayPlanVersion {
  id                                 String              @id @default(cuid())
  plan                               PayPlan?            @relation("PayPlanVersion_plan", fields: [planId], references: [id])
  planId                             String?             @map("plan")
  versionNumber                      Int
  hourlyRates                        Json?
  overtime                           Json?
  commission                         Json?
  spiffs                             Json?
  clawbacks                          Json?
  laterEngine                        Json?
  status                             String              @default("draft")
  contentHash                        String              @default("")
  approval                           ApprovalRequest?    @relation("PayPlanVersion_approval", fields: [approvalId], references: [id])
  approvalId                         String?             @map("approval")
  activatedAt                        DateTime?
  version                            Int                 @default(0)
  createdAt                          DateTime            @default(now())
  updatedAt                          DateTime            @default(now()) @updatedAt
  from_EarningLine_payPlanVersion    EarningLine[]       @relation("EarningLine_payPlanVersion")
  from_PayPlanAssignment_planVersion PayPlanAssignment[] @relation("PayPlanAssignment_planVersion")

  @@unique([planId, versionNumber], map: "PayPlanVersion_plan_number_key")
  @@index([planId])
  @@index([approvalId])
}

model PayrollExportBatch {
