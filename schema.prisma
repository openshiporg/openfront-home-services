}

model Task {
  id          String    @id @default(cuid())
  kind        String    @default("")
  title       String    @default("")
  detail      String    @default("")
  subjectType String    @default("")
  subjectId   String    @default("")
  dueAt       DateTime?
  assignee    User?     @relation("Task_assignee", fields: [assigneeId], references: [id])
  assigneeId  String?   @map("assignee")
  role        Role?     @relation("Task_role", fields: [roleId], references: [id])
  roleId      String?   @map("role")
  status      String    @default("open")
  priority    String    @default("normal")
  dedupeKey   String    @unique @default("")
  resolution  String    @default("")
  closedAt    DateTime?
  closedBy    User?     @relation("Task_closedBy", fields: [closedById], references: [id])
  closedById  String?   @map("closedBy")
  version     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([kind])
  @@index([subjectId])
  @@index([assigneeId])
  @@index([roleId])
  @@index([closedById])
}

model PolicyBinding {
  id         String      @id @default(cuid())
  pack       PolicyPack? @relation("PolicyBinding_pack", fields: [packId], references: [id])
  packId     String?     @map("pack")
  scope      String
  scopeValue String      @default("")
  branch     Branch?     @relation("PolicyBinding_branch", fields: [branchId], references: [id])
  branchId   String?     @map("branch")
  priority   Int?        @default(0)
  status     String      @default("active")
  version    Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  @@unique([packId, scope, scopeValue], map: "PolicyBinding_pack_scope_key")
  @@index([packId])
  @@index([branchId])
}

model PolicyPack {
  id               String          @id @default(cuid())
  code             String          @unique @default("")
  name             String          @default("")
  kind             String
  jurisdictionCode String          @default("")
  description      String          @default("")
  versions         PolicyVersion[] @relation("PolicyVersion_pack")
  bindings         PolicyBinding[] @relation("PolicyBinding_pack")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
}

model PolicyVersion {
  id            String           @id @default(cuid())
  pack          PolicyPack?      @relation("PolicyVersion_pack", fields: [packId], references: [id])
  packId        String?          @map("pack")
  versionNumber Int
  effectiveFrom DateTime         @postgresql.Date
  effectiveTo   DateTime?        @postgresql.Date
  rules         Json?
  sourceRefs    Json?
  verifiedBy    String           @default("")
  verifiedAt    DateTime?
  status        String           @default("draft")
  approval      ApprovalRequest? @relation("PolicyVersion_approval", fields: [approvalId], references: [id])
  approvalId    String?          @map("approval")
  contentHash   String           @default("")
  version       Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@unique([packId, versionNumber], map: "PolicyVersion_pack_number_key")
  @@index([packId])
  @@index([approvalId])
}

model AgentAction {
  id               String           @id @default(cuid())
  run              AgentRun?        @relation("AgentAction_run", fields: [runId], references: [id])
  runId            String?          @map("run")
  agent            AgentIdentity?   @relation("AgentAction_agent", fields: [agentId], references: [id])
  agentId          String?          @map("agent")
  tool             String           @default("")
  idempotencyKey   String           @unique @default("")
  inputsHash       String           @default("")
  inputsProvenance Json?
  output           Json?
  reasoningSummary String           @default("")
  status           String           @default("proposed")
  approval         ApprovalRequest? @relation("AgentAction_approval", fields: [approvalId], references: [id])
  approvalId       String?          @map("approval")
  appliedEffects   Json?
  version          Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@index([runId])
  @@index([agentId])
  @@index([tool])
  @@index([approvalId])
}

model AgentIdentity {
  id                                    String            @id @default(cuid())
  name                                  String            @unique @default("")
  kind                                  String            @default("llm_agent")
  provider                              String            @default("")
  modelRef                              String            @default("")
  owner                                 User?             @relation("AgentIdentity_owner", fields: [ownerId], references: [id])
  ownerId                               String?           @map("owner")
  oauthApp                              OAuthApp?         @relation("AgentIdentity_oauthApp", fields: [oauthAppId], references: [id])
  oauthAppId                            String?           @map("oauthApp")
  status                                String            @default("active")
  killSwitch                            Boolean           @default(false)
  limits                                Json?
  grants                                AgentScopeGrant[] @relation("AgentScopeGrant_agent")
  runs                                  AgentRun[]        @relation("AgentRun_agent")
  version                               Int               @default(0)
  createdAt                             DateTime          @default(now())
  updatedAt                             DateTime          @default(now()) @updatedAt
  from_ApprovalRequest_requestedByAgent ApprovalRequest[] @relation("ApprovalRequest_requestedByAgent")
  from_AuditEvent_actorAgent            AuditEvent[]      @relation("AuditEvent_actorAgent")
  from_AgentAction_agent                AgentAction[]     @relation("AgentAction_agent")

  @@index([ownerId])
  @@index([oauthAppId])
}

model AgentRun {
  id         String         @id @default(cuid())
  agent      AgentIdentity? @relation("AgentRun_agent", fields: [agentId], references: [id])
  agentId    String?        @map("agent")
  trigger    String
  callRef    String         @default("")
  startedAt  DateTime?      @default(now())
  endedAt    DateTime?
  status     String         @default("started")
  tokenUsage Json?
  costMinor  BigInt?
  actions    AgentAction[]  @relation("AgentAction_run")
  version    Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt

  @@index([agentId])
  @@index([callRef])
}

model AgentScopeGrant {
  id            String           @id @default(cuid())
  agent         AgentIdentity?   @relation("AgentScopeGrant_agent", fields: [agentId], references: [id])
  agentId       String?          @map("agent")
  tool          String           @default("")
  autonomy      String
  constraints   Json?
  status        String           @default("requested")
  grantedBy     User?            @relation("AgentScopeGrant_grantedBy", fields: [grantedById], references: [id])
  grantedById   String?          @map("grantedBy")
  approval      ApprovalRequest? @relation("AgentScopeGrant_approval", fields: [approvalId], references: [id])
  approvalId    String?          @map("approval")
  effectiveFrom DateTime?
  revokedAt     DateTime?
  version       Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@index([agentId])
  @@index([tool])
  @@index([grantedById])
  @@index([approvalId])
}

enum UserKindType {
  staff
  customer
  payer_contact
  agent_owner
}
