      "pack": "tx",
      "why": "16 CFR 429.0(a)(5): the repair the buyer asked for is excluded; Tex. §601.002(a): the merchant did not solicit it.",
      "facts": {
        "location": "buyer_residence",
        "initiatedBy": "customer_request",
        "timeZone": "America/Chicago",
        "lines": [
          {
            "id": "l1",
            "amountMinor": "18900",
            "trade": "plumbing",
            "cancellationClass": "requested_repair",
            "description": "Replace kitchen faucet cartridge"
          }
        ],
        "transactionAt": "2026-11-09T16:00:00Z"
      },
      "expect": {
        "applies": false,
        "governing": null,
        "coveredLineIds": [],
        "coveredAmountMinor": "0",
        "rules": {
          "ftc_cooling_off": {
            "applies": false,
            "reasons": [
              "requested_repair_lines_excluded",
              "no_covered_lines"
            ]
